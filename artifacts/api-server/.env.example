# ── Clerk authentication ────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google Analytics 4 — OAuth 2.0 (refresh-token flow) ─────────────────────
# Do NOT use a service-account JSON file. Use OAuth 2.0 instead.
#
# How to obtain a refresh token:
#   1. Create a Google Cloud project and enable the "Google Analytics Data API".
#   2. Create an OAuth 2.0 client (Web application) in Google Cloud Console.
#   3. Open the Google OAuth Playground (https://developers.google.com/oauthplayground).
#   4. In Settings (gear icon) enter your Client ID and Client Secret, tick
#      "Use your own OAuth credentials".
#   5. Under "Step 1 — Select & authorize APIs", find
#      "Google Analytics Data API v1" and select the
#      "https://www.googleapis.com/auth/analytics.readonly" scope.
#   6. Click "Authorize APIs", complete the Google sign-in.
#   7. Under "Step 2", click "Exchange authorization code for tokens".
#   8. Copy the "Refresh token" value into GOOGLE_OAUTH_REFRESH_TOKEN below.
#
# GOOGLE_GA4_PROPERTY_ID: numeric property ID from GA4 Admin → Property Settings
# VITE_GA4_MEASUREMENT_ID: starts with "G-" from GA4 Admin → Data Streams
#
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_GA4_PROPERTY_ID=
VITE_GA4_MEASUREMENT_ID=
