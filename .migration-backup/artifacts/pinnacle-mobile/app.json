{
  "expo": {
    "name": "Pinnacle Academic Classes",
    "slug": "pinnacle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinnacleac",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1F5C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kck.pinnacleac",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Pinnacle uses the camera to scan question papers for OCR processing.",
        "NSPhotoLibraryUsageDescription": "Pinnacle accesses your photo library to attach documents and images.",
        "NSMicrophoneUsageDescription": "Pinnacle may use the microphone for live class audio.",
        "NSLocationWhenInUseUsageDescription": "Pinnacle uses location to show your nearest centre."
      }
    },
    "android": {
      "package": "com.kck.pinnacleac",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1F5C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pinnacle to use your camera to scan documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pinnacle to access your photos to attach documents.",
          "cameraPermission": "Allow Pinnacle to use your camera to scan documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A1F5C",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
