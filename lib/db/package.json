{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "pre-push": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./sql/question-bank-pre-push.sql",
    "push": "pnpm run pre-push && drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "pnpm run pre-push && drizzle-kit push --force --config ./drizzle.config.ts",
    "seed": "tsx src/seed.ts",
    "seed-questions": "tsx src/seed-questions.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
