# ═══════════════════════════════════════════════════════════════════════════
#  Pinnacle Academic Classes — Environment Variables Reference
#  Copy this file to .env and fill in all values before running.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pinnacle:yourpassword@localhost:5432/pinnacle
POSTGRES_PASSWORD=yourpassword            # used by docker-compose postgres service

# ── Clerk Authentication ──────────────────────────────────────────────────
# Obtain from https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# Website build-time key (same value as CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── Security ──────────────────────────────────────────────────────────────
# 64-character hex string — generate with: openssl rand -hex 32
SOCIAL_TOKEN_ENCRYPTION_KEY=

# ── Application URLs ──────────────────────────────────────────────────────
WEBSITE_BASE_URL=https://yourdomain.com

# ── Google Analytics 4 (optional) ────────────────────────────────────────
# Measurement ID starts with "G-"
VITE_GA4_MEASUREMENT_ID=

# OAuth refresh-token flow (for GA4 in admin panel)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_GA4_PROPERTY_ID=

# ── Social Media (optional — configure via Admin panel instead) ───────────
# Facebook / Instagram
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Twitter / X
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ── Email / SMTP (optional — configure via Admin panel instead) ───────────
# Leave blank to configure through the Admin → SMTP Settings panel
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=care@paconline.in
