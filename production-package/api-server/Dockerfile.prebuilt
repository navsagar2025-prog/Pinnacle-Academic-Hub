# Pre-built image — no source code required, no build step on server.
# Use this when you have already built dist/ locally or via CI.
FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY dist/ ./dist/

USER appuser

EXPOSE 8080
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
