# =============================================================================
# Pinnacle platform — production environment template.
# Copy to `.env` next to docker-compose.yml and fill in real values.
# DO NOT commit the populated .env file.
# =============================================================================

# --- Public URLs / domain ----------------------------------------------------
# The fully-qualified domain Caddy should obtain a TLS cert for, e.g.
# pinnacleacademic.in   (use ":80" for HTTP-only first-boot testing).
PUBLIC_DOMAIN=pinnacleacademic.example.com
# Email Let's Encrypt uses for renewal notices.
ACME_EMAIL=ops@example.com
# Same as PUBLIC_DOMAIN with scheme — used for CORS and absolute links.
PUBLIC_APP_URL=https://pinnacleacademic.example.com
# Next.js basePath. Leave EMPTY in production (apex serves the website).
BASE_PATH=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=pinnacle
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=pinnacle
# Connection string used by the API, web, and migrate services. Host MUST be
# the compose service name `postgres`.
DATABASE_URL=postgres://pinnacle:change-me-to-a-long-random-string@postgres:5432/pinnacle

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# --- Clerk authentication ----------------------------------------------------
# Provision your own Clerk tenant at https://clerk.com — Replit-managed Clerk
# does not work outside Replit.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# --- Cron / signed jobs ------------------------------------------------------
# Random 32+ char string used to authorise /api/v1/cron/* requests.
CRON_SECRET=change-me-to-a-long-random-string

# --- Razorpay payments -------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# --- Resend email ------------------------------------------------------------
RESEND_API_KEY=re_xxx
EMAIL_FROM=Pinnacle Academic Classes <care@paconline.in>
ADMIN_EMAIL=care@paconline.in

# --- AI providers (set the ones you use; others may be left blank) -----------
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Object storage ----------------------------------------------------------
# Format: /<bucket-name>/<prefix>. The website creates objects under
# `<bucket>/<prefix>/<category>/<uuid>`.
PRIVATE_OBJECT_DIR=/pinnacle-private/uploads
#
# OCI deployments must provide Google Cloud Storage credentials (the website
# uses the @google-cloud/storage SDK). Either:
#   (a) Inline JSON of a service-account key (single line). Recommended for
#       containerized deploys — no extra mount needed:
#         GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
#   OR
#   (b) Mount a key file into the web container and point at it:
#         GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-key.json
# Optional explicit project id (auto-detected from the credential otherwise):
#   GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#
# If both are blank, the website assumes the Replit object-storage sidecar at
# 127.0.0.1:1106 — that mode is for the Replit dev environment only. Note that
# the GCS bucket referenced by PRIVATE_OBJECT_DIR must allow the service
# account `roles/storage.objectAdmin` (or finer-grained equivalent).
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# --- Zoom integration --------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- OCR providers (optional) ------------------------------------------------
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
GOOGLE_VISION_API_KEY=
LATEXOCR_URL=
LATEXOCR_API_KEY=
SIMPLETEX_URL=
SIMPLETEX_API_KEY=
PIX2TEXT_URL=
PIX2TEXT_API_KEY=
